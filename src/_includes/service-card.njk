{% macro card(s, lang) %}
{% set isAr = lang == "ar" %}
<article class="sub-card reveal">
  <div class="thumb">
    {% set dims = s.img | imageDims %}
    <picture>
      <source srcset="{{ '../' if isAr }}{{ s.img | webpSrc }}" type="image/webp">
      <img src="{{ '../' if isAr }}{{ s.img }}" alt="{{ s.alt[lang] | safe }}" width="{{ dims.w }}" height="{{ dims.h }}" loading="lazy" decoding="async">
    </picture>
  </div>
  <div class="body"><h4>{{ s.name[lang] | safe }}</h4><p>{{ s.desc[lang] | safe }}</p><a href="#contact" class="link" data-service="{{ s.name[lang] | safe }}">{{ "Request quote" if lang == "en" else "اطلب عرض سعر" }} <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a></div>
</article>
{% endmacro %}
