{# offHome: true on any page that isn't the homepage itself (faq.html or a
   detail page) — Services/Specialties links need an "index.html#" prefix.
   onFaqPage: true only when this IS the FAQ page specifically — controls
   aria-current="page" on the FAQs link. A detail page is offHome but not
   onFaqPage; the FAQ page is both. #}
{% set logoHref = "#top" if not offHome else "index.html#top" %}
{% set servicesHref = "#services" if not offHome else "index.html#services" %}
{% set specialtiesHref = "#specialties" if not offHome else "index.html#specialties" %}
<header>
  <nav>
    <a class="logo" href="{{ logoHref }}">{{ "PROCRAFTX" if lang == "en" else "بروكرافتكس" }}</a>
    <ul class="nav-links" id="navLinks">
      <li><a href="{{ servicesHref }}">{{ site.nav.services[lang] | safe }}</a></li>
      <li><a href="{{ specialtiesHref }}">{{ site.nav.specialties[lang] | safe }}</a></li>
      <li><a href="faq.html"{{ ' aria-current="page"' | safe if onFaqPage }}>{{ site.nav.faqs[lang] | safe }}</a></li>
    </ul>
    <div class="nav-cta">
      <button class="lang-toggle" id="langToggle" type="button"><span class="lang-en"><svg class="flag-icon" viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" fill="#fff"/><rect width="20" height="1.08" fill="#B22234"/><rect y="2.15" width="20" height="1.08" fill="#B22234"/><rect y="4.31" width="20" height="1.08" fill="#B22234"/><rect y="6.46" width="20" height="1.08" fill="#B22234"/><rect y="8.62" width="20" height="1.08" fill="#B22234"/><rect y="10.77" width="20" height="1.08" fill="#B22234"/><rect y="12.92" width="20" height="1.08" fill="#B22234"/><rect width="8" height="7.54" fill="#3C3B6E"/></svg>ENGLISH</span><span class="lang-sep"> / </span><span class="lang-ar"><svg class="flag-icon" viewBox="0 0 20 14" aria-hidden="true"><rect width="20" height="14" fill="#fff"/><rect width="20" height="4.67" fill="#00732F"/><rect y="9.33" width="20" height="4.67" fill="#000"/><rect width="6" height="14" fill="#CE1126"/></svg>عربي</span></button>
    </div>
    <button class="burger" id="burgerBtn" aria-label="{{ site.nav.burgerAriaLabel[lang] | safe }}" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
  </nav>
</header>
