{% macro section(lang, isAr, site, services, specialties, prefillService) %}
<section id="contact" class="section">
  <div class="cta-section reveal">
    <div class="wrap">
      <form class="book-form" id="bookForm" novalidate>
        <div class="field-row">
          <div class="field" id="nameField">
            <label for="name">{{ site.bookingForm.nameLabel[lang] | safe }}</label><input id="name" type="text" placeholder="{{ site.bookingForm.namePlaceholder[lang] | safe }}" maxlength="100" autocomplete="name" required aria-required="true" aria-describedby="nameErr">
            <span class="error-msg" id="nameErr" role="alert">{{ site.bookingForm.nameError[lang] | safe }}</span>
          </div>
          <div class="field" id="phoneField">
            <label for="phone">{{ site.bookingForm.phoneLabel[lang] | safe }}</label><input id="phone" type="tel" dir="ltr" placeholder="{{ site.business.phoneDisplay }}" maxlength="20" autocomplete="tel" required aria-required="true" aria-describedby="phoneErr">
            <span class="error-msg" id="phoneErr" role="alert">{{ site.bookingForm.phoneError[lang] | safe }}</span>
          </div>
        </div>
        <div class="field"><label for="address">{{ site.bookingForm.addressLabel[lang] | safe }}</label><input id="address" type="text" placeholder="{{ site.bookingForm.addressPlaceholder[lang] | safe }}" maxlength="200" autocomplete="street-address"></div>
        <div class="field">
          <label for="service">{{ site.bookingForm.serviceLabel[lang] | safe }}</label>
          <select id="service">
            {% for cat in services.categories %}
            <optgroup label="{{ cat.title[lang] | safe }}">
              {% for s in cat.services %}
              <option{{ ' selected' | safe if prefillService and s.name[lang] == prefillService }}>{{ s.name[lang] | safe }}</option>
              {% endfor %}
            </optgroup>
            {% endfor %}
            {% for sp in specialties | sort(attribute="bookingOrder") %}
            <optgroup label="{{ sp.bookingGroupLabel[lang] | safe }}">
              {% for opt in sp.bookingOptions %}
              <option{{ ' selected' | safe if prefillService and opt[lang] == prefillService }}>{{ opt[lang] | safe }}</option>
              {% endfor %}
            </optgroup>
            {% endfor %}
            <optgroup label="{{ site.customizeCard.title[lang] | safe }}">
              <option{{ ' selected' | safe if prefillService and site.customizeCard.title[lang] == prefillService }}>{{ site.customizeCard.title[lang] | safe }}</option>
            </optgroup>
            <option{{ ' selected' | safe if prefillService and site.bookingForm.notSure[lang] == prefillService }}>{{ site.bookingForm.notSure[lang] | safe }}</option>
          </select>
        </div>
        <div class="field"><label for="notes">{{ site.bookingForm.notesLabel[lang] | safe }}</label><textarea id="notes" placeholder="{{ site.bookingForm.notesPlaceholder[lang] | safe }}" maxlength="1000"></textarea></div>
        <button type="submit" class="btn btn-red">{{ site.bookingForm.submit[lang] | safe }}</button>
        <p class="confirm" role="status">{{ site.bookingForm.confirm[lang] | safe }}</p>
      </form>
      <div>
        <span class="eyebrow">{{ site.bookingForm.getStartedEyebrow[lang] | safe }}</span>
        <h2>{{ site.bookingForm.getStartedH2[lang] | safe }}</h2>
        <p class="lead">{{ site.bookingForm.getStartedLead[lang] | safe }}</p>
        <div class="contact-info">
          <a class="row" href="{{ site.business.whatsapp }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M3 21l1.4-4.2A8.9 8.9 0 1 1 8.2 20L3 21z"/><path d="M8.5 8.5c0 4 3 7 7 7 .6 0 1-.4.9-1l-.4-1.7a1 1 0 0 0-1.2-.7l-1.4.4a6 6 0 0 1-3-3l.4-1.4a1 1 0 0 0-.7-1.2L8.2 6.5c-.6-.1-1 .3-1 .9z"/></svg><div><b dir="ltr">{{ site.business.phoneDisplay }}</b><span>{{ site.contactRows[0].sub[lang] | safe }}</span></div></a>
          <a class="row" href="mailto:{{ site.business.email }}"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg><div><b>{{ site.business.email }}</b><span>{{ site.contactRows[1].sub[lang] | safe }}</span></div></a>
          <a class="row" href="{{ site.business.social.instagram }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg><div><b>@Procraftx.ae</b><span>{{ site.contactRows[2].sub[lang] | safe }}</span></div></a>
          <a class="row" href="{{ site.business.social.facebook }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg><div><b>Procraftx</b><span>{{ site.contactRows[3].sub[lang] | safe }}</span></div></a>
          <a class="row" href="{{ site.business.social.tiktok }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="var(--red)"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg><div><b>@Procraftx.ae</b><span>{{ site.contactRows[4].sub[lang] | safe }}</span></div></a>
          <a class="row" href="{{ site.business.social.x }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="var(--red)"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg><div><b>@Procraftxae</b><span>{{ site.contactRows[5].sub[lang] | safe }}</span></div></a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endmacro %}
