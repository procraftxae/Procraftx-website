{% set homeHref = "index.html" if offHome else "#top" %}
{% set servicesHref = "index.html#services" if offHome else "#services" %}
{% set specialtiesHref = "index.html#specialties" if offHome else "#specialties" %}
{% set aboutHref = "index.html#about" if offHome else "#about" %}
{% set contactHref = "index.html#contact" if offHome else "#contact" %}
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="logo" href="{{ homeHref }}">{{ "PROCRAFTX" if lang == "en" else "بروكرافتكس" }}</a>
      <p>{{ site.footer.tagline[lang] | safe }}</p>
    </div>

    <div class="footer-col">
      <h4>{{ site.footer.quickLinksTitle[lang] | safe }}</h4>
      <ul>
        <li><a href="{{ servicesHref }}">{{ site.nav.services[lang] | safe }}</a></li>
        <li><a href="{{ specialtiesHref }}">{{ site.nav.specialties[lang] | safe }}</a></li>
        <li><a href="{{ aboutHref }}">{{ site.footer.aboutLink[lang] | safe }}</a></li>
        <li><a href="faq.html">{{ site.nav.faqs[lang] | safe }}</a></li>
        <li><a href="{{ contactHref }}">{{ site.footer.contactLink[lang] | safe }}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>{{ site.footer.servicesTitle[lang] | safe }}</h4>
      <ul>
        {% for cat in services.categories %}
        <li><a href="{{ cat.id }}.html">{{ cat.title[lang] | safe }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-col">
      <h4>{{ site.footer.specialtiesTitle[lang] | safe }}</h4>
      <ul>
        {% for sp in specialties | sort(attribute="bookingOrder") %}
        <li><a href="{{ sp.id }}.html">{{ sp.h3[lang] | safe }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-col footer-contact">
      <h4>{{ site.footer.contactTitle[lang] | safe }}</h4>
      <ul>
        <li><a href="{{ site.business.whatsapp }}" target="_blank" rel="noopener" dir="ltr">{{ site.business.phoneDisplay }}</a></li>
        <li><a href="mailto:{{ site.business.email }}">{{ site.business.email }}</a></li>
      </ul>
      <p class="footer-areas">{{ site.footer.areaServedLabel[lang] | safe }}: {% for a in site.business.areaServed %}{{ a[lang] | safe }}{{ ", " if not loop.last }}{% endfor %}</p>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="wrap footer-bottom-inner">
      <p>&copy; {{ currentYear }} {{ site.business.name }}. {{ site.footer.rights[lang] | safe }}</p>
      <div class="footer-social">
        <a href="{{ site.business.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M3 21l1.4-4.2A8.9 8.9 0 1 1 8.2 20L3 21z"/><path d="M8.5 8.5c0 4 3 7 7 7 .6 0 1-.4.9-1l-.4-1.7a1 1 0 0 0-1.2-.7l-1.4.4a6 6 0 0 1-3-3l.4-1.4a1 1 0 0 0-.7-1.2L8.2 6.5c-.6-.1-1 .3-1 .9z"/></svg></a>
        <a href="mailto:{{ site.business.email }}" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg></a>
        <a href="{{ site.business.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
        <a href="{{ site.business.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
        <a href="{{ site.business.social.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/></svg></a>
        <a href="{{ site.business.social.x }}" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
