---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{% if lang == 'ar' %}ar/portfolio.html{% else %}portfolio.html{% endif %}"
---
{%- set isAr = lang == "ar" -%}
{%- set p = pages.portfolio -%}
{%- set totalProjects = 0 -%}
{%- for cat in portfolio -%}{%- set totalProjects = totalProjects + cat.projects.length -%}{%- endfor -%}
<!DOCTYPE html>
<html lang="{{ lang }}"{{ ' dir="rtl"' | safe if isAr }}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% include "gtm-head.njk" %}
<meta name="google-site-verification" content="_IPAHV06IH3jP_eau1n5NKWp9_Zfgb3BOBFFXUx4otM">
<link rel="icon" href="{{ '../' if isAr }}assets/images/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ '../' if isAr }}assets/images/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="{{ '../' if isAr }}assets/images/apple-touch-icon.png">
<title>{{ p.title[lang] | safe }}</title>
<meta name="description" content="{{ p.description[lang] | safe }}">
{% if totalProjects == 0 %}<meta name="robots" content="noindex, follow">{% endif %}
<link rel="canonical" href="https://www.procraftx.ae/{{ 'ar/' if isAr }}portfolio.html">
<link rel="alternate" hreflang="en" href="https://www.procraftx.ae/portfolio.html">
<link rel="alternate" hreflang="ar" href="https://www.procraftx.ae/ar/portfolio.html">
<link rel="alternate" hreflang="x-default" href="https://www.procraftx.ae/portfolio.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Procraftx">
<meta property="og:title" content="{{ p.ogTitle[lang] | safe }}">
<meta property="og:description" content="{{ p.ogDescription[lang] | safe }}">
<meta property="og:url" content="https://www.procraftx.ae/{{ 'ar/' if isAr }}portfolio.html">
<meta property="og:image" content="https://www.procraftx.ae/assets/images/service-promo-poster.jpg">
<meta property="og:locale" content="{{ 'ar_AE' if isAr else 'en_AE' }}">
<meta property="og:locale:alternate" content="{{ 'en_AE' if isAr else 'ar_AE' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ p.ogTitle[lang] | safe }}">
<meta name="twitter:description" content="{{ p.twitterDescription[lang] | safe }}">
<meta name="twitter:image" content="https://www.procraftx.ae/assets/images/service-promo-poster.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '../styles.css' if isAr else 'styles.css' }}">
</head>
<body>
{% include "gtm-body.njk" %}

<a href="#main" class="skip-link">{{ site.skipLink[lang] | safe }}</a>

{% set offHome = true %}
{% include "nav.njk" %}

<main id="main">

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="index.html">{{ site.detailPage.breadcrumbHome[lang] | safe }}</a> / <span>{{ p.heroH1[lang] | safe }}</span></nav>
      <span class="eyebrow">{{ p.heroEyebrow[lang] | safe }}</span>
      <h1>{{ p.heroH1[lang] | safe }}</h1>
      <p>{{ p.heroLead[lang] | safe }}</p>
    </div>

    {% if totalProjects == 0 %}
    <div class="portfolio-empty reveal">
      <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="9" r="1.75"/><path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.12 0L3 21"/></svg>
      <h2>{{ p.emptyStateTitle[lang] | safe }}</h2>
      <p>{{ p.emptyStateBody[lang] | safe }}</p>
      <a href="{{ site.business.whatsapp }}" class="btn btn-red" target="_blank" rel="noopener">{{ site.about.cta[lang] | safe }}</a>
    </div>
    {% else %}
    {% for cat in portfolio %}
    {% if cat.projects.length %}
    <div class="category-block">
      <div class="category-head reveal"><div><h3>{{ cat.title[lang] | safe }}</h3></div></div>
      <div class="portfolio-grid">
        {% for proj in cat.projects %}
        {% set dims = proj.image | imageDims %}
        <figure class="portfolio-item reveal">
          <picture>
            <source srcset="{{ '../' if isAr }}{{ proj.image | webpSrc }}" type="image/webp">
            <img src="{{ '../' if isAr }}{{ proj.image }}" alt="{{ proj.alt[lang] | safe }}" width="{{ dims.w }}" height="{{ dims.h }}" loading="lazy" decoding="async">
          </picture>
          {% if proj.caption %}<figcaption>{{ proj.caption[lang] | safe }}</figcaption>{% endif %}
        </figure>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
    {% endif %}
  </div>
</section>

</main>

{% include "footer.njk" %}

<script src="{{ '../assets/js/main.js' if isAr else 'assets/js/main.js' }}"></script>
{% include "whatsapp-float.njk" %}
</body>
</html>
