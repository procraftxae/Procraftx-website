---
pagination:
  data: guidePages
  size: 1
  alias: page
permalink: "{% if page.lang == 'ar' %}ar/{{ pages[page.pageKey].slug }}.html{% else %}{{ pages[page.pageKey].slug }}.html{% endif %}"
---
{%- set lang = page.lang -%}
{%- set g = pages[page.pageKey] -%}
{%- set isAr = lang == "ar" -%}
<!DOCTYPE html>
<html lang="{{ lang }}"{{ ' dir="rtl"' | safe if isAr }}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% include "gtm-head.njk" %}
<meta name="google-site-verification" content="_IPAHV06IH3jP_eau1n5NKWp9_Zfgb3BOBFFXUx4otM">
<link rel="icon" href="{{ '../' if isAr }}assets/images/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ '../' if isAr }}assets/images/favicon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="{{ '../' if isAr }}assets/images/apple-touch-icon.png">
<meta name="theme-color" content="#000000">
<title>{{ g.title[lang] | safe }}</title>
<meta name="description" content="{{ g.description[lang] | safe }}">
<link rel="canonical" href="https://www.procraftx.ae/{{ 'ar/' if isAr }}{{ g.slug }}.html">
<link rel="alternate" hreflang="en" href="https://www.procraftx.ae/{{ g.slug }}.html">
<link rel="alternate" hreflang="ar" href="https://www.procraftx.ae/ar/{{ g.slug }}.html">
<link rel="alternate" hreflang="x-default" href="https://www.procraftx.ae/{{ g.slug }}.html">
<meta property="og:type" content="article">
<meta property="og:site_name" content="Procraftx">
<meta property="og:title" content="{{ g.ogTitle[lang] | safe }}">
<meta property="og:description" content="{{ g.ogDescription[lang] | safe }}">
<meta property="og:url" content="https://www.procraftx.ae/{{ 'ar/' if isAr }}{{ g.slug }}.html">
<meta property="og:image" content="https://www.procraftx.ae/assets/images/service-promo-poster.jpg">
<meta property="og:locale" content="{{ 'ar_AE' if isAr else 'en_AE' }}">
<meta property="og:locale:alternate" content="{{ 'en_AE' if isAr else 'ar_AE' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ g.ogTitle[lang] | safe }}">
<meta name="twitter:description" content="{{ g.twitterDescription[lang] | safe }}">
<meta name="twitter:image" content="https://www.procraftx.ae/assets/images/service-promo-poster.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '../styles.css' if isAr else 'styles.css' }}">
<script type="application/ld+json">
{{ page.pageKey | articleJsonLd(lang) | safe }}
</script>
<script type="application/ld+json">
{{ page.pageKey | guideBreadcrumbJsonLd(lang) | safe }}
</script>
</head>
<body>
{% include "gtm-body.njk" %}

<a href="#main" class="skip-link">{{ site.skipLink[lang] | safe }}</a>

{% set offHome = true %}
{% include "nav.njk" %}

<main id="main">

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="index.html">{{ site.detailPage.breadcrumbHome[lang] | safe }}</a> / <span>{{ g.heroH1[lang] | safe }}</span></nav>
      <span class="eyebrow">{{ g.heroEyebrow[lang] | safe }}</span>
      <h1>{{ g.heroH1[lang] | safe }}</h1>
      <p>{{ g.lastUpdated[lang] | safe }}</p>
    </div>

    <div class="legal-content reveal">
      {% for sec in g.sections %}
      <h2>{{ sec.h2[lang] | safe }}</h2>
      <p>{{ sec.body[lang] | safe }}</p>
      {% endfor %}
    </div>
  </div>
</section>

</main>

{% include "footer.njk" %}

<script src="{{ '../assets/js/main.js' if isAr else 'assets/js/main.js' }}"></script>
{% include "whatsapp-float.njk" %}
</body>
</html>
