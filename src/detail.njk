---
pagination:
  data: detailPages
  size: 1
  alias: page
permalink: "{% if page.lang == 'ar' %}ar/{{ page.topic.id }}.html{% else %}{{ page.topic.id }}.html{% endif %}"
---
{%- set lang = page.lang -%}
{%- set topic = page.topic -%}
{%- set content = detailContent[topic.id] -%}
{%- from "contact-section.njk" import section as contactSection -%}
{%- set isAr = lang == "ar" -%}
<!DOCTYPE html>
<html lang="{{ lang }}"{{ ' dir="rtl"' | safe if isAr }}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="_IPAHV06IH3jP_eau1n5NKWp9_Zfgb3BOBFFXUx4otM">
<title>{{ content.metaTitle[lang] | safe }}</title>
<meta name="description" content="{{ content.metaDescription[lang] | safe }}">
<link rel="canonical" href="https://procraftx.ae/{{ 'ar/' if isAr }}{{ topic.id }}.html">
<link rel="alternate" hreflang="en" href="https://procraftx.ae/{{ topic.id }}.html">
<link rel="alternate" hreflang="ar" href="https://procraftx.ae/ar/{{ topic.id }}.html">
<link rel="alternate" hreflang="x-default" href="https://procraftx.ae/{{ topic.id }}.html">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Procraftx">
<meta property="og:title" content="{{ content.metaTitle[lang] | safe }}">
<meta property="og:description" content="{{ content.metaDescription[lang] | safe }}">
<meta property="og:url" content="https://procraftx.ae/{{ 'ar/' if isAr }}{{ topic.id }}.html">
<meta property="og:image" content="https://procraftx.ae/{{ topic.images[0].src }}">
<meta property="og:locale" content="{{ 'ar_AE' if isAr else 'en_AE' }}">
<meta property="og:locale:alternate" content="{{ 'en_AE' if isAr else 'ar_AE' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ content.metaTitle[lang] | safe }}">
<meta name="twitter:description" content="{{ content.metaDescription[lang] | safe }}">
<meta name="twitter:image" content="https://procraftx.ae/{{ topic.images[0].src }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800&family=Noto+Sans:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '../styles.css' if isAr else 'styles.css' }}">
<script type="application/ld+json">
{{ topic.id | detailServiceJsonLd(lang) | safe }}
</script>
<script type="application/ld+json">
{{ topic.id | detailFaqJsonLd(lang) | safe }}
</script>
<script type="application/ld+json">
{{ topic.id | detailBreadcrumbJsonLd(lang) | safe }}
</script>
</head>
<body>

<a href="#main" class="skip-link">{{ site.skipLink[lang] | safe }}</a>

{% set offHome = true %}
{% include "nav.njk" %}

<main id="main">

<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <nav class="breadcrumb" aria-label="Breadcrumb"><a href="index.html">{{ site.detailPage.breadcrumbHome[lang] | safe }}</a> / <span>{{ topic.h3[lang] | safe }}</span></nav>
      <span class="eyebrow">{{ topic.h3[lang] | safe }}</span>
      <h1>{{ content.h1[lang] | safe }}</h1>
    </div>

    <div class="detail-media reveal">
      <div class="thumb thumb-slideshow">
        {% for img in topic.images %}
        <img src="{{ '../' if isAr }}{{ img.src }}" alt="{{ img.alt[lang] | safe }}" loading="lazy"{{ ' style="display:none"' | safe if not loop.first }}>
        {% endfor %}
        <button type="button" class="thumb-nav thumb-prev" aria-label="{{ 'Previous photo' if lang == 'en' else 'الصورة السابقة' }}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button type="button" class="thumb-nav thumb-next" aria-label="{{ 'Next photo' if lang == 'en' else 'الصورة التالية' }}"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>
        <div class="thumb-dots"></div>
      </div>
    </div>

    <div class="detail-overview reveal">
      {% for p in content.overview[lang] %}
      <p>{{ p | safe }}</p>
      {% endfor %}
    </div>

    <div class="detail-included reveal">
      <h2>{{ site.detailPage.whatsIncludedTitle[lang] | safe }}</h2>
      <ul>
        {% for item in content.whatsIncluded[lang] %}
        <li>{{ item | safe }}</li>
        {% endfor %}
      </ul>
    </div>

    {% if topic.services %}
    <div class="subservice-grid">
      {% for s in topic.services %}
      <div class="sub-card reveal">
        <div class="thumb"><img src="{{ '../' if isAr }}{{ s.img }}" alt="{{ s.alt[lang] | safe }}" loading="lazy"></div>
        <div class="body"><h4>{{ s.name[lang] | safe }}</h4><p>{{ s.desc[lang] | safe }}</p><a href="#contact" class="link" data-service="{{ s.name[lang] | safe }}">{{ "Request quote" if lang == "en" else "اطلب عرض سعر" }} <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="detail-process reveal">
      <h2>{{ site.detailPage.processTitle[lang] | safe }}</h2>
      <div class="process-grid">
        {% for step in site.detailPage.processSteps %}
        <div class="process-step">
          <span class="process-num">{{ loop.index }}</span>
          <h3>{{ step.title[lang] | safe }}</h3>
          <p>{{ step.desc[lang] | safe }}</p>
        </div>
        {% endfor %}
      </div>
      <a href="#contact" class="btn btn-red" data-service="{{ topic.dataService[lang] | safe }}">{{ "Request quote" if lang == "en" else "اطلب عرض سعر" }} <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></a>
    </div>

    {% set faqGroupMatch = topic.id | detailFaqGroup %}
    {% if faqGroupMatch %}
    {% from "faq-group.njk" import group as faqGroup %}
    {{ faqGroup(faqGroupMatch, lang, 0) }}
    {% endif %}

    <div class="detail-related reveal">
      <h2>{{ site.detailPage.relatedTitle[lang] | safe }}</h2>
      <ul class="related-list">
        {% for rel in content.relatedIds | relatedTopics(lang) %}
        <li><a href="{{ rel.href }}">{{ rel.label | safe }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{%- set prefillService = topic.dataService[lang] if topic.kind == "specialty" else site.bookingForm.notSure[lang] -%}
{{ contactSection(lang, isAr, site, services, specialties, prefillService) }}

</main>

<script src="{{ '../assets/js/main.js' if isAr else 'assets/js/main.js' }}"></script>
{% include "whatsapp-float.njk" %}
</body>
</html>
